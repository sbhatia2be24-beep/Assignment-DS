#include <iostream>
#include <queue>
using namespace std;

class Stack1Q {
    queue<int> q;

public:
    void push(int x) {
        int s = q.size();
        q.push(x);
        while (s--) {
            q.push(q.front());
            q.pop();
        }
    }

    void pop() {
        if (q.empty()) {
            cout << "Empty\n";
            return;
        }
        cout << q.front() << " popped\n";
        q.pop();
    }

    void top() {
        if (q.empty()) cout << "Empty\n";
        else cout << "Top = " << q.front() << endl;
    }
};

#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

void improvedSelectionSort(vector<int>& arr) {
    int n = arr.size();
    int start = 0;
    int end = n - 1;

    // Iterate while the start pointer is less than the end pointer
    while (start < end) {
        int min_idx = start;
        int max_idx = start;

        // Find min and max in the current range [start, end]
        for (int i = start + 1; i <= end; i++) {
            if (arr[i] < arr[min_idx]) {
                min_idx = i;
            }
            if (arr[i] > arr[max_idx]) {
                max_idx = i;
            }
        }

        // Swap the minimum element to the start position
        swap(arr[min_idx], arr[start]);

        // CRITICAL FIX: 
        // If the maximum element was at the 'start' position, it has just been 
        // moved to 'min_idx' by the previous swap. We must update max_idx.
        if (max_idx == start) {
            max_idx = min_idx;
        }

        // Swap the maximum element to the end position
        swap(arr[max_idx], arr[end]);

        // Move the pointers inward
        start++;
        end--;
        
        // Optional: Visualization of passes
        // for(int x : arr) cout << x << " "; cout << endl; 
    }
}

int main() {
    int n;
    cout << "--- Improved Selection Sort (Min-Max) ---\n";
    cout << "Enter number of elements: ";
    cin >> n;
    
    vector<int> arr(n);
    cout << "Enter the elements: ";
    for(int i=0; i<n; i++) cin >> arr[i];

    cout << "Original Array: ";
    for(int x : arr) cout << x << " ";
    cout << endl;

    improvedSelectionSort(arr);

    cout << "Sorted Array:   ";
    for(int x : arr) cout << x << " ";
    cout << endl;

    return 0;
}

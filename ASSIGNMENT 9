#include <iostream>
#include <vector>
#include <algorithm>
#include <queue>

using namespace std;

// Structure to represent a weighted edge
struct Edge {
    int src, dest, weight;
};

// --- For Kruskal's Algorithm (Disjoint Set Union) ---
struct DSU {
    int* parent;
    int* rank;
    int n;

    DSU(int n) {
        this->n = n;
        parent = new int[n];
        rank = new int[n];
        for (int i = 0; i < n; i++) {
            parent[i] = i;
            rank[i] = 0;
        }
    }

    int find(int i) {
        if (parent[i] == i)
            return i;
        return parent[i] = find(parent[i]);
    }

    void unite(int x, int y) {
        int s1 = find(x);
        int s2 = find(y);
        if (s1 != s2) {
            if (rank[s1] < rank[s2])
                parent[s1] = s2;
            else if (rank[s1] > rank[s2])
                parent[s2] = s1;
            else {
                parent[s2] = s1;
                rank[s1]++;
            }
        }
    }
};

bool compareEdges(Edge a, Edge b) {
    return a.weight < b.weight;
}

void kruskalMST(vector<Edge>& edges, int V) {
    sort(edges.begin(), edges.end(), compareEdges);
    DSU s(V);
    int mstWeight = 0;
    cout << "\nEdges in Kruskal's MST:\n";
    for (auto edge : edges) {
        if (s.find(edge.src) != s.find(edge.dest)) {
            s.unite(edge.src, edge.dest);
            mstWeight += edge.weight;
            cout << edge.src << " -- " << edge.dest << " == " << edge.weight << endl;
        }
    }
    cout << "Total Weight of MST: " << mstWeight << endl;
}

// --- For Prim's Algorithm ---
typedef pair<int, int> iPair; // weight, vertex

void primMST(vector<vector<iPair>>& adj, int V) {
    priority_queue<iPair, vector<iPair>, greater<iPair>> pq;
    int src = 0; // Starting from vertex 0
    vector<int> key(V, 1e9);
    vector<int> parent(V, -1);
    vector<bool> inMST(V, false);

    pq.push(make_pair(0, src));
    key[src] = 0;

    int mstWeight = 0;

    while (!pq.empty()) {
        int u = pq.top().second;
        pq.pop();

        if (inMST[u]) continue;
        inMST[u] = true;
        mstWeight += key[u];

        for (auto x : adj[u]) {
            int v = x.first;
            int weight = x.second;
            if (!inMST[v] && key[v] > weight) {
                key[v] = weight;
                pq.push(make_pair(key[v], v));
                parent[v] = u;
            }
        }
    }

    cout << "\nEdges in Prim's MST:\n";
    for (int i = 1; i < V; ++i)
        cout << parent[i] << " -- " << i << " == " << key[i] << endl;
    cout << "Total Weight of MST: " << mstWeight << endl;
}

int main() {
    int V, E, u, v, w, choice;
    cout << "Enter number of vertices: ";
    cin >> V;
    cout << "Enter number of edges: ";
    cin >> E;

    vector<Edge> edges;
    vector<vector<iPair>> adj(V);

    cout << "Enter edges (u v w):\n";
    for (int i = 0; i < E; i++) {
        cin >> u >> v >> w;
        edges.push_back({u, v, w});
        adj[u].push_back(make_pair(v, w));
        adj[v].push_back(make_pair(u, w));
    }

    cout << "\nChoose Algorithm:\n1. Kruskal's Algorithm\n2. Prim's Algorithm\nEnter choice: ";
    cin >> choice;

    if (choice == 1) kruskalMST(edges, V);
    else if (choice == 2) primMST(adj, V);
    else cout << "Invalid choice";

    return 0;
}


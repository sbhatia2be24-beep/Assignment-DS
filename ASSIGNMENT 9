#include <iostream>
#include <vector>
#include <list>
#include <queue>

using namespace std;

class Graph {
    int V; // Number of vertices
    vector<list<int>> adj; // Adjacency list

public:
    Graph(int V);
    void addEdge(int v, int w);
    void BFS(int s);
};

Graph::Graph(int V) {
    this->V = V;
    adj.resize(V);
}

void Graph::addEdge(int v, int w) {
    adj[v].push_back(w); // Add w to v's list
    adj[w].push_back(v); // For undirected graph
}

void Graph::BFS(int s) {
    vector<bool> visited(V, false);
    queue<int> queue;

    visited[s] = true;
    queue.push(s);

    cout << "BFS Traversal starting from vertex " << s << ": ";

    while(!queue.empty()) {
        s = queue.front();
        cout << s << " ";
        queue.pop();

        for(auto i : adj[s]) {
            if(!visited[i]) {
                visited[i] = true;
                queue.push(i);
            }
        }
    }
    cout << endl;
}

int main() {
    int V, E, u, v, startNode;
    cout << "--- Breadth First Search (BFS) ---\n";
    cout << "Enter number of vertices: ";
    cin >> V;
    Graph g(V);

    cout << "Enter number of edges: ";
    cin >> E;

    cout << "Enter edges (u v):\n";
    for(int i = 0; i < E; i++) {
        cin >> u >> v;
        g.addEdge(u, v);
    }

    cout << "Enter starting vertex: ";
    cin >> startNode;

    g.BFS(startNode);

    return 0;
}


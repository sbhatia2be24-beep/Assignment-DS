#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

// Heapify for Max Heap (Increasing Order)
void heapifyMax(vector<int>& arr, int n, int i) {
    int largest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;

    if (left < n && arr[left] > arr[largest]) largest = left;
    if (right < n && arr[right] > arr[largest]) largest = right;

    if (largest != i) {
        swap(arr[i], arr[largest]);
        heapifyMax(arr, n, largest);
    }
}

// Heapify for Min Heap (Decreasing Order)
void heapifyMin(vector<int>& arr, int n, int i) {
    int smallest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;

    if (left < n && arr[left] < arr[smallest]) smallest = left;
    if (right < n && arr[right] < arr[smallest]) smallest = right;

    if (smallest != i) {
        swap(arr[i], arr[smallest]);
        heapifyMin(arr, n, smallest);
    }
}

void heapSort(vector<int>& arr, bool increasing) {
    int n = arr.size();

    // Build heap
    for (int i = n / 2 - 1; i >= 0; i--) {
        if (increasing) heapifyMax(arr, n, i);
        else heapifyMin(arr, n, i);
    }

    // Extract elements one by one
    for (int i = n - 1; i > 0; i--) {
        swap(arr[0], arr[i]);
        if (increasing) heapifyMax(arr, i, 0);
        else heapifyMin(arr, i, 0);
    }
}

void printArray(const vector<int>& arr) {
    for (int i : arr) cout << i << " ";
    cout << "\n";
}

int main() {
    int n;
    cout << "Enter number of elements: ";
    cin >> n;
    vector<int> arr(n);
    cout << "Enter elements: ";
    for (int i = 0; i < n; i++) cin >> arr[i];

    vector<int> arrInc = arr;
    vector<int> arrDec = arr;

    cout << "Original Array: "; printArray(arr);

    heapSort(arrInc, true);
    cout << "Sorted Increasing (Max Heap): "; printArray(arrInc);

    heapSort(arrDec, false);
    cout << "Sorted Decreasing (Min Heap): "; printArray(arrDec);

    return 0;
}


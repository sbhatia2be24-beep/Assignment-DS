#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

class PriorityQueue {
    vector<int> heap;

    void heapifyUp(int index) {
        if (index == 0) return;
        int parent = (index - 1) / 2;
        if (heap[parent] < heap[index]) {
            swap(heap[parent], heap[index]);
            heapifyUp(parent);
        }
    }

    void heapifyDown(int index) {
        int left = 2 * index + 1;
        int right = 2 * index + 2;
        int largest = index;

        if (left < heap.size() && heap[left] > heap[largest]) largest = left;
        if (right < heap.size() && heap[right] > heap[largest]) largest = right;

        if (largest != index) {
            swap(heap[index], heap[largest]);
            heapifyDown(largest);
        }
    }

public:
    void insert(int element) {
        heap.push_back(element);
        heapifyUp(heap.size() - 1);
        cout << "Inserted " << element << endl;
    }

    void extractMax() {
        if (heap.empty()) {
            cout << "Queue is empty!\n";
            return;
        }
        int maxElem = heap[0];
        heap[0] = heap.back();
        heap.pop_back();
        if (!heap.empty()) heapifyDown(0);
        cout << "Extracted Max: " << maxElem << endl;
    }

    void getMax() {
        if (heap.empty()) cout << "Queue is empty!\n";
        else cout << "Current Max: " << heap[0] << endl;
    }

    void display() {
        if (heap.empty()) {
            cout << "Queue is empty\n";
            return;
        }
        cout << "Priority Queue: ";
        for (int i : heap) cout << i << " ";
        cout << endl;
    }
};

int main() {
    PriorityQueue pq;
    int choice, val;

    do {
        cout << "\n--- Priority Queue Menu ---\n";
        cout << "1. Insert\n2. Extract Max\n3. Get Max\n4. Display\n0. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {
        case 1:
            cout << "Enter value: "; cin >> val;
            pq.insert(val);
            break;
        case 2:
            pq.extractMax();
            break;
        case 3:
            pq.getMax();
            break;
        case 4:
            pq.display();
            break;
        }
    } while (choice != 0);

    return 0;
}

#include <iostream>
#include <climits>
using namespace std;

struct Node {
    int data;
    Node* left;
    Node* right;
    Node(int val) : data(val), left(nullptr), right(nullptr) {}
};

class BST {
public:
    Node* root;

    BST() : root(nullptr) {}

    // --- Q3(a): Insert (No duplicates) ---
    Node* insert(Node* node, int val) {
        if (node == nullptr) return new Node(val);
        if (val < node->data)
            node->left = insert(node->left, val);
        else if (val > node->data)
            node->right = insert(node->right, val);
        // If val == node->data, do nothing (no duplicates)
        return node;
    }

    // --- Q1: Traversals (Recursive) ---
    void preOrder(Node* node) {
        if (!node) return;
        cout << node->data << " ";
        preOrder(node->left);
        preOrder(node->right);
    }

    void inOrder(Node* node) {
        if (!node) return;
        inOrder(node->left);
        cout << node->data << " ";
        inOrder(node->right);
    }

    void postOrder(Node* node) {
        if (!node) return;
        postOrder(node->left);
        postOrder(node->right);
        cout << node->data << " ";
    }

    // --- Q2(a): Search ---
    bool searchRecursive(Node* node, int key) {
        if (!node) return false;
        if (node->data == key) return true;
        if (key < node->data) return searchRecursive(node->left, key);
        return searchRecursive(node->right, key);
    }

    bool searchIterative(Node* node, int key) {
        while (node) {
            if (key == node->data) return true;
            if (key < node->data) node = node->left;
            else node = node->right;
        }
        return false;
    }

    // --- Q2(b) & Q2(c): Min and Max Element ---
    Node* findMin(Node* node) {
        while (node && node->left) node = node->left;
        return node;
    }

    Node* findMax(Node* node) {
        while (node && node->right) node = node->right;
        return node;
    }

    // --- Q3(b): Delete an element ---
    Node* deleteNode(Node* root, int key) {
        if (!root) return root;
        if (key < root->data)
            root->left = deleteNode(root->left, key);
        else if (key > root->data)
            root->right = deleteNode(root->right, key);
        else {
            // Node with only one child or no child
            if (!root->left) {
                Node* temp = root->right;
                delete root;
                return temp;
            } else if (!root->right) {
                Node* temp = root->left;
                delete root;
                return temp;
            }
            // Node with two children: Get inorder successor (smallest in right subtree)
            Node* temp = findMin(root->right);
            root->data = temp->data;
            root->right = deleteNode(root->right, temp->data);
        }
        return root;
    }

    // --- Q2(d): In-order Successor ---
    void getSuccessor(Node* root, int key) {
        Node* succ = nullptr;
        Node* curr = root;
        while (curr) {
            if (key < curr->data) {
                succ = curr;
                curr = curr->left;
            } else if (key >= curr->data) {
                curr = curr->right;
            }
        }
        if (succ) cout << "Successor of " << key << " is " << succ->data << endl;
        else cout << "No Successor found for " << key << endl;
    }

    // --- Q2(e): In-order Predecessor ---
    void getPredecessor(Node* root, int key) {
        Node* pre = nullptr;
        Node* curr = root;
        while (curr) {
            if (key > curr->data) {
                pre = curr;
                curr = curr->right;
            } else if (key <= curr->data) {
                curr = curr->left;
            }
        }
        if (pre) cout << "Predecessor of " << key << " is " << pre->data << endl;
        else cout << "No Predecessor found for " << key << endl;
    }

    // --- Q3(c): Maximum Depth ---
    int maxDepth(Node* node) {
        if (!node) return 0;
        int lDepth = maxDepth(node->left);
        int rDepth = maxDepth(node->right);
        return max(lDepth, rDepth) + 1;
    }

    // --- Q3(d): Minimum Depth ---
    int minDepth(Node* node) {
        if (!node) return 0;
        if (!node->left && !node->right) return 1;
        if (!node->left) return minDepth(node->right) + 1;
        if (!node->right) return minDepth(node->left) + 1;
        return min(minDepth(node->left), minDepth(node->right)) + 1;
    }

    // --- Q4: Check if Binary Tree is BST ---
    bool isBST(Node* node, long minVal, long maxVal) {
        if (!node) return true;
        if (node->data <= minVal || node->data >= maxVal) return false;
        return isBST(node->left, minVal, node->data) &&
               isBST(node->right, node->data, maxVal);
    }
};

int main() {
    BST tree;
    int choice, val;

    do {
        cout << "\n--- BST MENU ---\n";
        cout << "1. Insert\n2. Delete\n3. Traversals (Pre/In/Post)\n";
        cout << "4. Search\n5. Min/Max Element\n6. Successor/Predecessor\n";
        cout << "7. Max/Min Depth\n8. Check if BST\n0. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {
        case 1:
            cout << "Enter value to insert: "; cin >> val;
            tree.root = tree.insert(tree.root, val);
            break;
        case 2:
            cout << "Enter value to delete: "; cin >> val;
            tree.root = tree.deleteNode(tree.root, val);
            break;
        case 3:
            cout << "Pre: "; tree.preOrder(tree.root); cout << endl;
            cout << "In : "; tree.inOrder(tree.root); cout << endl;
            cout << "Post: "; tree.postOrder(tree.root); cout << endl;
            break;
        case 4:
            cout << "Enter value to search: "; cin >> val;
            if (tree.searchRecursive(tree.root, val)) cout << "Found (Recursive)\n";
            else cout << "Not Found\n";
            break;
        case 5:
            if (tree.root) {
                cout << "Min: " << tree.findMin(tree.root)->data << endl;
                cout << "Max: " << tree.findMax(tree.root)->data << endl;
            } else cout << "Tree is empty\n";
            break;
        case 6:
            cout << "Enter value: "; cin >> val;
            tree.getSuccessor(tree.root, val);
            tree.getPredecessor(tree.root, val);
            break;
        case 7:
            cout << "Max Depth: " << tree.maxDepth(tree.root) << endl;
            cout << "Min Depth: " << tree.minDepth(tree.root) << endl;
            break;
        case 8:
            if (tree.isBST(tree.root, LONG_MIN, LONG_MAX)) cout << "It is a valid BST\n";
            else cout << "It is NOT a valid BST\n";
            break;
        }
    } while (choice != 0);

    return 0;
}


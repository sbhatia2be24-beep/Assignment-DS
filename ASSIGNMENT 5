    if (!head) {
        head = newNode;
        return;
    }
    Node* temp = head;
    while (temp->next) temp = temp->next;
    temp->next = newNode;
}

void findMiddle(Node* head) {
    if (!head) return;
    
    Node* slow = head;
    Node* fast = head;

    while (fast != nullptr && fast->next != nullptr) {
        slow = slow->next;
        fast = fast->next->next;
    }

    cout << "Middle Element: " << slow->data << endl;
}

int main() {
    Node* head = nullptr;
    // Input: 1->2->3->4->5
    int arr[] = {1, 2, 3, 4, 5};
    for(int x : arr) insert(head, x);

    findMiddle(head);

    return 0;
}


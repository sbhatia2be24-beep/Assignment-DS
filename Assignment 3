#include <iostream>
#include <stack>
using namespace std;

bool isMatch(char a, char b) {
    return (a=='(' && b==')') ||
           (a=='{' && b=='}') ||
           (a=='[' && b==']');
}

int main() {
    string exp;
    cin >> exp;

    stack<char> st;

    for (char c : exp) {
        if (c=='(' || c=='{' || c=='[')
            st.push(c);
        else {
            if (st.empty() || !isMatch(st.top(), c)) {
                cout << "Not Balanced";
                return 0;
            }
            st.pop();
        }
    }

    cout << (st.empty() ? "Balanced" : "Not Balanced");
}


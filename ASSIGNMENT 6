#include <iostream>
using namespace std;

// --- Doubly Linked List Implementation ---
struct DNode {
    int data;
    DNode* prev;
    DNode* next;
    DNode(int val) : data(val), prev(nullptr), next(nullptr) {}
};

class DoublyLinkedList {
    DNode* head;
public:
    DoublyLinkedList() : head(nullptr) {}

    // (a) Insertion
    void insertAtHead(int val) {
        DNode* newNode = new DNode(val);
        if (head) {
            newNode->next = head;
            head->prev = newNode;
        }
        head = newNode;
    }

    void insertAtTail(int val) {
        DNode* newNode = new DNode(val);
        if (!head) {
            head = newNode;
            return;
        }
        DNode* temp = head;
        while (temp->next) temp = temp->next;
        temp->next = newNode;
        newNode->prev = temp;
    }

    void insertAfter(int key, int val) {
        DNode* temp = head;
        while (temp && temp->data != key) temp = temp->next;
        if (!temp) {
            cout << "Node " << key << " not found.\n";
            return;
        }
        DNode* newNode = new DNode(val);
        newNode->next = temp->next;
        newNode->prev = temp;
        if (temp->next) temp->next->prev = newNode;
        temp->next = newNode;
    }

    // (b) Deletion
    void deleteNode(int key) {
        if (!head) return;
        DNode* temp = head;
        while (temp && temp->data != key) temp = temp->next;

        if (!temp) {
            cout << "Node " << key << " not found.\n";
            return;
        }

        if (temp == head) {
            head = head->next;
            if (head) head->prev = nullptr;
        } else {
            temp->prev->next = temp->next;
            if (temp->next) temp->next->prev = temp->prev;
        }
        delete temp;
        cout << "Deleted " << key << ".\n";
    }

    // (c) Search
    void search(int key) {
        DNode* temp = head;
        int pos = 1;
        while (temp) {
            if (temp->data == key) {
                cout << "Found " << key << " at position " << pos << ".\n";
                return;
            }
            temp = temp->next;
            pos++;
        }
        cout << key << " not found.\n";
    }

    void display() {
        DNode* temp = head;
        while (temp) {
            cout << temp->data << " <-> ";
            temp = temp->next;
        }
        cout << "NULL\n";
    }
};

// --- Circular Linked List Implementation ---
struct CNode {
    int data;
    CNode* next;
    CNode(int val) : data(val), next(nullptr) {}
};

class CircularLinkedList {
    CNode* head;
public:
    CircularLinkedList() : head(nullptr) {}

    // (a) Insertion
    void insertAtHead(int val) {
        CNode* newNode = new CNode(val);
        if (!head) {
            head = newNode;
            newNode->next = head;
        } else {
            CNode* temp = head;
            while (temp->next != head) temp = temp->next;
            newNode->next = head;
            temp->next = newNode;
            head = newNode;
        }
    }

    void insertAtTail(int val) {
        if (!head) {
            insertAtHead(val);
            return;
        }
        CNode* newNode = new CNode(val);
        CNode* temp = head;
        while (temp->next != head) temp = temp->next;
        temp->next = newNode;
        newNode->next = head;
    }

    // (b) Deletion
    void deleteNode(int key) {
        if (!head) return;

        // If head needs to be deleted
        if (head->data == key) {
            if (head->next == head) { // Only one node
                delete head;
                head = nullptr;
            } else {
                CNode* temp = head;
                while (temp->next != head) temp = temp->next;
                CNode* toDel = head;
                temp->next = head->next;
                head = head->next;
                delete toDel;
            }
            cout << "Deleted " << key << ".\n";
            return;
        }

        CNode* curr = head;
        CNode* prev = nullptr;
        while (curr->next != head && curr->data != key) {
            prev = curr;
            curr = curr->next;
        }

        if (curr->data == key) {
            prev->next = curr->next;
            delete curr;
            cout << "Deleted " << key << ".\n";
        } else {
            cout << "Node " << key << " not found.\n";
        }
    }

    // (c) Search
    void search(int key) {
        if (!head) {
            cout << "List is empty.\n";
            return;
        }
        CNode* temp = head;
        int pos = 1;
        do {
            if (temp->data == key) {
                cout << "Found " << key << " at position " << pos << ".\n";
                return;
            }
            temp = temp->next;
            pos++;
        } while (temp != head);
        cout << key << " not found.\n";
    }

    void display() {
        if (!head) {
            cout << "List Empty\n";
            return;
        }
        CNode* temp = head;
        do {
            cout << temp->data << " -> ";
            temp = temp->next;
        } while (temp != head);
        cout << "(HEAD)\n";
    }
};


#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
    Node(int val) : data(val), next(nullptr) {}
};

bool isCircular(Node* head) {
    if (!head) return true; // An empty list can be considered circular def.

    Node* temp = head->next;
    while (temp != nullptr && temp != head) {
        temp = temp->next;
    }

    // If temp reached head, it's circular. If temp reached NULL, it's not.
    return (temp == head);
}

int main() {
    // Case 1: Circular List (2->4->6->7->5->2)
    Node* head = new Node(2);
    head->next = new Node(4);
    head->next->next = new Node(6);
    head->next->next->next = new Node(7);
    head->next->next->next->next = new Node(5);
    
    // Creating the loop
    head->next->next->next->next->next = head;

    if (isCircular(head))
        cout << "True" << endl;
    else
        cout << "False" << endl;

    return 0;
}


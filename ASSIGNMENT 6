// Node structure for Doubly Linked List
struct DNode {
    int data;
    DNode *next, *prev;
    DNode(int val) : data(val), next(nullptr), prev(nullptr) {}
};

// Node structure for Circular Linked List
struct CNode {
    int data;
    CNode* next;
    CNode(int val) : data(val), next(nullptr) {}
};

// i. Find size of Doubly Linked List
int sizeDLL(DNode* head) {
    int count = 0;
    while (head) {
        count++;
        head = head->next;
    }
    return count;
}

// ii. Find size of Circular Linked List
int sizeCLL(CNode* head) {
    if (!head) return 0;
    int count = 0;
    CNode* temp = head;
    do {
        count++;
        temp = temp->next;
    } while (temp != head);
    return count;
}

int main() {
    // Setup DLL
    DNode* dHead = new DNode(10);
    dHead->next = new DNode(20);
    dHead->next->prev = dHead;
    dHead->next->next = new DNode(30);
    dHead->next->next->prev = dHead->next;

    // Setup CLL
    CNode* cHead = new CNode(5);
    cHead->next = new CNode(15);
    cHead->next->next = cHead; // Loop back

    cout << "Size of DLL: " << sizeDLL(dHead) << endl;
    cout << "Size of CLL: " << sizeCLL(cHead) << endl;

    return 0;
}


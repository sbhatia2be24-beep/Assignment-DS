#include <iostream>
using namespace std;

int main() {
    int a, b;
    cin >> a >> b;

    int A[20][3], B[20][3], C[40][3];
    for (int i = 0; i < a; i++) cin >> A[i][0] >> A[i][1] >> A[i][2];
    for (int i = 0; i < b; i++) cin >> B[i][0] >> B[i][1] >> B[i][2];

    int k = 0;

    for (int i = 0; i < a; i++) {
        for (int j = 0; j < b; j++) {
            if (A[i][1] == B[j][0]) {
                C[k][0] = A[i][0];
                C[k][1] = B[j][1];
                C[k][2] = A[i][2] * B[j][2];
                k++;
            }
        }
    }

    cout << "Product Sparse Matrix:\n";
    for (int p = 0; p < k; p++)
        cout << C[p][0] << " " << C[p][1] << " " << C[p][2] << endl;
}


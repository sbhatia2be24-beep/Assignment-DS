#include <iostream>
using namespace std;

int main() {
    int m, n;
    cin >> m >> n;

    int A[20][3], B[20][3], C[40][3];
    for (int i = 0; i < m; i++) cin >> A[i][0] >> A[i][1] >> A[i][2];
    for (int i = 0; i < n; i++) cin >> B[i][0] >> B[i][1] >> B[i][2];

    int i = 0, j = 0, k = 0;

    while (i < m && j < n) {
        if (A[i][0] == B[j][0] && A[i][1] == B[j][1]) {
            C[k][0] = A[i][0];
            C[k][1] = A[i][1];
            C[k][2] = A[i][2] + B[j][2];
            i++; j++; k++;
        }
        else if (A[i][0] < B[j][0] ||
                (A[i][0] == B[j][0] && A[i][1] < B[j][1])) {
            C[k][0] = A[i][0];
            C[k][1] = A[i][1];
            C[k][2] = A[i][2];
            i++; k++;
        }
        else {
            C[k][0] = B[j][0];
            C[k][1] = B[j][1];
            C[k][2] = B[j][2];
            j++; k++;
        }
    }

    while (i < m) C[k][0] = A[i][0], C[k][1] = A[i][1], C[k][2] = A[i][2], i++, k++;
    while (j < n) C[k][0] = B[j][0], C[k][1] = B[j][1], C[k][2] = B[j][2], j++, k++;

    cout << "Added Sparse Matrix:\n";
    for (int p = 0; p < k; p++)
        cout << C[p][0] << " " << C[p][1] << " " << C[p][2] << endl;
}


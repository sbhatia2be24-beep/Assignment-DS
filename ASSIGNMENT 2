    int arr[] = {64, 34, 25, 12, 22, 11, 90};
    int n = 7;

    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1])
                swap(arr[j], arr[j + 1]);
        }
    }

    cout << "Sorted array: ";
    for (int x : arr)
        cout << x << " ";

    return 0;
}

